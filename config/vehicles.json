{
  "version": "v1.0-validated",
  "_doc": "docs/02-game-balance.md §8.1、docs/01-game-rules.md §10",
  "_design": "車不是純粹的加速道具，而是落點控制道具：持有車輛者每次擲骰可選擇停在骰點或骰點 + 1。目標是不存在普遍最優解 — P1 模擬的驗證標準是三種車 + 無車的勝率差距 < 10 個百分點。",

  "⚠_daily_mode_open_question": "日常型改為每日固定擲骰次數後，車輛不再是多繞圈工具，而是『骰點或骰點 + 1』的落點選擇權。價值來自避開高租金、追求無主地或避開酒駕風險；代價是每圈稅費/養護、折舊、自然 6 超速檢定，以及酒吧/酒店休閒格的代駕/酒駕選擇。P1 模擬必須驗證多一格選擇是否足以抵消持有成本。",

  "vehicles": [
    { "key": "none",     "name": "無",     "price": 0,       "move_choice_extra": 0, "upkeep_per_turn": 0,     "parking_fee_per_lodging": 0 },
    { "key": "scooter",  "name": "機車",   "price": 80000,   "move_choice_extra": 1, "upkeep_per_turn": 1000,  "parking_fee_per_lodging": 500 },
    { "key": "domestic", "name": "國產車", "price": 600000,  "move_choice_extra": 1, "upkeep_per_turn": 5000,  "parking_fee_per_lodging": 2000 },
    { "key": "imported", "name": "進口車", "price": 1800000, "move_choice_extra": 1, "upkeep_per_turn": 15000, "parking_fee_per_lodging": 5000 }
  ],

  "parking": {
    "charged_when": "pay_lodging_or_rent_on_property_tile",
    "paid_to": "system",
    "_note": "持有車輛者只要在地產格支付住宿費/租金，需額外支付該車種停車費。停車費給系統，不給地主；住在自己的地產不收。"
  },

  "traffic_risk": {
    "speeding_trigger": "natural_roll == 6",
    "dui_trigger": "land_on_leisure_bar_or_club_with_vehicle",
    "accident_triggers": [
      {
        "key": "fate_car_accident",
        "source": "fate:F04",
        "base_rule": "命運卡直接觸發事故；持有車輛者承擔完整金額，無車者視為行人/大眾運輸事故，金額減半。"
      },
      {
        "key": "speeding_failed_check",
        "source": "traffic_check",
        "trigger": "natural_roll == 6 && has_vehicle && failed_speeding_check",
        "effect": { "type": "pay", "category": "accident", "amount": 60000, "covered_by": "accident" }
      },
      {
        "key": "dui_failed_check",
        "source": "traffic_check",
        "trigger": "land_on_bar_or_club && has_vehicle && choose_self_drive && failed_dui_check",
        "effect": { "type": "pay_and_jail", "category": "jail", "amount": 80000, "jail": 2, "accident_chance": 0.30 }
      }
    ],
    "_note": "自然骰出 6 且持有車輛會觸發超速檢定；落在酒吧/酒店類休閒格時必須選代駕或承擔酒駕檢定。車禍可由命運卡直接觸發，也可由超速/酒駕檢定失敗升級而來。"
  },

  "depreciation": {
    "per_year_ratio": 0.25,
    "laps_per_year": 4,
    "_note": "每 4 圈（1 遊戲年）殘值 −25%。"
  },

  "sale": {
    "at_dmv_ratio": 0.90,
    "online_ratio": 0.80,
    "online_fee": 5000,
    "on_bankruptcy_ratio": 0.70
  },

  "purchase": {
    "free_at_dmv": true,
    "online_fee": 5000
  }
}
