{
  "version": "2026.08.3",
  "_doc": "docs/04-economy-and-realdata.md §2-3",

  "_pricing_decision": "直接使用真實股價，不做映射。前一版採「統一基準價 $1,000 + 套用真實漲跌幅」，已廢除。改用真實價的理由見 docs/04 §3。seed_price 為 2026-08-05（民國 1150805）TWSE STOCK_DAY_ALL 的真實收盤價快照，非虛構資料 — 開發期直接當種子用，P5 接上每日同步後即由實際收盤價覆寫。",

  "trading": {
    "use_real_price": true,
    "price_basis": "previous_close",
    "_price_basis_note": "一律 T+1（前一交易日收盤價），全程無盤中報價。這消除了即時性壓力，也讓遊戲不觸碰延遲揭露規範。",
    "min_unit_shares": 1,
    "_unit_note": "以「股」而非「張」為單位。起始現金 $180,000 可買 74 股台積電或 1,734 股 0050 — 尺度成立。",
    "brokerage_fee_rate": 0.001425,
    "brokerage_fee_min": 20,
    "transaction_tax_rate": 0.003,
    "transaction_tax_on": "sell",
    "max_single_holding_ratio": 0.60,
    "allow_margin": false,
    "allow_short": false,
    "daily_return_clamp": 0.10
  },

  "trading_window": {
    "_design": "股票不是棋盤格。交易併入「通過起點的季度事務」— 沒有時窗長度的概念，就是你辦季度事務時順手做的一件事。",
    "trigger": "quarterly_affairs",
    "once_per_lap": true,
    "_removed": "證交所格已從棋盤移除。前兩版分別採用過『全域開盤鐘』與『過起點後 N 小時個人時窗』，都已廢除 — 前者要協調所有人、後者仍有時限壓力。",
    "_rationale": "日常型每天固定擲骰；通過起點才算 1 圈 = 1 次季度事務 = 1 次 T+1 價格更新。每天預期約一次交易機會，不需要盯時鐘。",
    "blitz_non_blocking": true,
    "_blitz_note": "即時配對型的季度事務是非阻塞側欄，可在別人回合時處理，不卡住牌桌。"
  },

  "price_advance": {
    "daily": { "mode": "one_real_trading_day_per_lap",
      "_note": "日常型 1 圈 = 1 天，天然對齊真實交易日。休市日沿用前一交易日收盤價。" },
    "blitz": { "mode": "one_real_trading_day_per_lap",
      "_note": "即時配對型的整局在真實世界只過了 20-45 分鐘，若不推進價格則股價紋風不動、股票淪為呆滯資產。改為每圈推進一個真實交易日，一局 4 圈即回放 4 天真實行情。開局時決定起始日期。" },
    "_unified": "兩種模式皆為「每圈推進一個交易日」，規則一致。"
  },

  "dividend": {
    "cycle_laps": 4,
    "yield_per_year": 0.032,
    "_note": "約當台股年均殖利率。以持股市值計算，不逐檔區分。"
  },

  "data_source": {
    "provider": "TWSE OpenAPI",
    "endpoint": "https://openapi.twse.com.tw/v1/exchangeReport/STOCK_DAY_ALL",
    "auth_required": false,
    "cost": 0,
    "latency": "T+1",
    "verified_at": "2026-08-06",
    "seed_snapshot_date": "1150805",
    "_caveats": [
      "只回傳單日資料，歷史序列必須自己每天抓下來存",
      "所有數值為 string，需自行轉型",
      "Change 是漲跌『價差』不是百分比，漲跌幅需自算：Change / (ClosingPrice - Change)",
      "停牌或無成交的個股價格欄位可能為 '--' 或空字串，必須防禦性解析",
      "無 SLA、無穩定性保證",
      "債券 ETF 與部分標的會下市或改代號（00679B 元大美債20年 已不在 2026-08 的清單中），標的清單需定期核對"
    ]
  },

  "fallback": {
    "_doc": "docs/04-economy-and-realdata.md §6",
    "retry_times": ["15:30", "16:30", "17:30"],
